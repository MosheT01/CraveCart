# Local / docker-compose only. Production Cloud Run reads keys from GCP Secret Manager; Fly hybrid deploy must use deploy-fly.ps1 -FromGcpSecretManager (see docs/deploy-cloud-run.md).

# Public origin of the Next app (no trailing slash). Must match the URL users open in the browser.
# Production (Cloud Run): set automatically by cloudbuild "sync-public-urls" step, or set to your custom domain.
APP_BASE_URL=http://localhost:3000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

YOUTUBE_API_KEY=

KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Must exactly match a redirect URI registered in the Kroger developer console (HTTPS in production).
KROGER_REDIRECT_URI=http://localhost:3000/auth/kroger/callback
KROGER_LOCATION_ID=

# Shared between web and MCP sidecars only (never exposed to the browser). Use the same value as GCP Secret INTERNAL_SIDECAR_SECRET in prod.
INTERNAL_SIDECAR_SECRET=

# Optional: Kroger OAuth + Products REST host. Certification/Sandbox credentials are issued on api-ce.kroger.com — match it here while testing.
# Production default is unset (uses api.kroger.com).
# KROGER_API_HOST=api-ce.kroger.com
# Optional OAuth scope override for Product Search client-credentials token (default product.compact).
# KROGER_CLIENT_CREDENTIALS_SCOPE=

# Sidecar base URLs. In docker-compose these are internal service names; on Cloud Run use each service's https://*.run.app URL (see docs/deploy-cloud-run.md).
KROGER_SIDECAR_URL=http://127.0.0.1:8000
# Use trailing /mcp/ (avoids redirect chain that breaks Streamable MCP behind Cloud Run).
KROGER_MCP_URL=http://127.0.0.1:8000/mcp/
YOUTUBE_SERVICE_URL=http://127.0.0.1:8100
YOUTUBE_MCP_URL=http://127.0.0.1:8100/mcp/

# Optional: set at image build or Cloud Run deploy for /api/health (never commit real secrets).
# GIT_SHA=
# K_SERVICE and K_REVISION are set automatically on Cloud Run.

# MCP JSON-RPC tools/call timeout (ms). Default in code is 180000; raises SDK limit above 60000 for cold starts + YouTube.
# MCP_TOOL_TIMEOUT_MS=180000
