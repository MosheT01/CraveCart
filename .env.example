# Local / Docker Compose only. Production: GCP Secret Manager (see docs/deploy-cloud-run.md, cloudbuild.yaml).

# --- Firebase (required) — Authentication (Email/Password) + Firestore for users + chat persistence ---
# 1) Firebase Console: Authentication → Email/Password; Firestore (Native mode); authorized domains.
# 2) Project settings → Service accounts → Generate new private key → save JSON on disk (do not commit).
# Preferred local / pnpm dev: path to that file (POSIX path OK on Windows, e.g. C:/Users/…/adminsdk-….json).
FIREBASE_SERVICE_ACCOUNT_PATH=
# Docker Compose mounts this host file → /secrets/firebase-sa.json inside the web container:
FIREBASE_SERVICE_ACCOUNT_HOST_PATH=
# Or set FIREBASE_SERVICE_ACCOUNT_JSON to minified ONE-line JSON (e.g. Cloud Run Secret Manager).
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Project settings → Your apps → Web app → copy API key:
FIREBASE_WEB_API_KEY=
# If authDomain differs from `{projectId}.firebaseapp.com`, set explicitly (Firebase console shows both):
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
# Firestore rules: firebase deploy --only firestore:rules (uses firebase.json)

# Public origin of the Next app (no trailing slash). Must match the URL users open in the browser.
# Production (Cloud Run): set automatically by cloudbuild "sync-public-urls" step, or your custom domain.
APP_BASE_URL=http://localhost:3000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

YOUTUBE_API_KEY=

KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_REDIRECT_URI=http://localhost:3000/auth/kroger/callback
KROGER_LOCATION_ID=

INTERNAL_SIDECAR_SECRET=

# Optional: Kroger Certification API host — match while testing.
# KROGER_API_HOST=api-ce.kroger.com
# KROGER_CLIENT_CREDENTIALS_SCOPE=

KROGER_SIDECAR_URL=http://127.0.0.1:8000
KROGER_MCP_URL=http://127.0.0.1:8000/mcp/
YOUTUBE_SERVICE_URL=http://127.0.0.1:8100
YOUTUBE_MCP_URL=http://127.0.0.1:8100/mcp/

# GIT_SHA=
# MCP_TOOL_TIMEOUT_MS=180000
